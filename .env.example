# Токен бота от @BotFather / 从 @BotFather 获取的机器人令牌
BOT_TOKEN=

# Ключ OpenAI — нужен для разбора чужих КП и перевода.
# Без него работает только свой формат КП и без перевода.
# OpenAI 密钥：用于识别工厂报价单和翻译。不填则仅支持贵司格式且无翻译。
OPENAI_API_KEY=

# Модель (temperature не передаётся) / 模型
OPENAI_MODEL=gpt-5-mini

# Необязательно: прокси для OpenAI, если сервер в КНР или РФ
# 可选：当服务器位于中国或俄罗斯时使用的代理地址
OPENAI_BASE_URL=

# Кому разрешён доступ: Telegram ID через запятую. Пусто = всем.
# 允许使用的 Telegram ID，用逗号分隔。留空表示所有人可用。
ALLOWED_USER_IDS=
